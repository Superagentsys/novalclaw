{
  "manifest_version": 3,
  "name": "OmniNova Personal Chrome",
  "version": "0.1.0",
  "description": "OmniNova Personal Chrome transport and authorized-tab content-script control. Load unpacked for development.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms", "tabs"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OmniNova Personal Chrome",
    "default_popup": "popup.html"
  }
}
